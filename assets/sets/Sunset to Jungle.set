afterglow-set 1
name "Sunset to Jungle"
length 67111872

transition "Bass Swap"
description "Brings the new track in without its bass, then swaps the basslines on the drop. The go-to club transition."
beats 32
in_start 0
out_effect none 0
lane xfade 0:0:1 0.25:0.5:0 0.75:0.5:1 1:1:0
lane out_low 0:0.5:2 0.5:0:0 1:0:0
lane in_low 0:0:2 0.5:0.5:0 1:0.5:0
end

transition "Filter Sweep"
description "The outgoing track is thinned out with a rising high-pass while the new track opens up from a low-pass."
beats 16
in_start 0
out_effect none 0
lane xfade 0:0:1 0.300000012:0.5:0 0.699999988:0.5:1 1:1:0
lane out_filter 0:0.5:1 1:0.920000017:0
lane in_filter 0:0.0799999982:1 0.850000024:0.5:0 1:0.5:0
end

transition "Long EQ Blend"
description "A patient 16-bar mix: highs first, basses swapped at the midpoint, then the old track fades away."
beats 64
in_start 0
out_effect none 0
lane xfade 0:0:1 0.200000003:0.5:0 0.75:0.5:1 1:1:0
lane out_low 0:0.5:2 0.5:0:0 1:0:0
lane in_low 0:0:2 0.5:0.5:0 1:0.5:0
lane in_mid 0:0.300000012:1 0.5:0.5:0 1:0.5:0
lane out_high 0:0.5:0 0.5:0.5:1 0.899999976:0.200000003:0 1:0.200000003:0
lane in_high 0:0.200000003:1 0.349999994:0.5:0 1:0.5:0
end

transition "Wash Out"
description "High-pass plus echo washes the old track into the distance while the new one fades up underneath."
beats 16
in_start 0
out_effect none 0
lane xfade 0:0:1 0.5:0.5:1 0.800000012:1:0 1:1:0
lane out_vol 0:1:0 0.699999988:1:1 0.800000012:0:0 1:0:0
lane out_filter 0:0.5:1 0.75:0.850000024:0 1:0.850000024:0
lane out_echo 0:0:1 0.600000024:0.800000012:0 1:0.800000012:0
end

transition "Echo Out"
description "The old track dissolves into echoes, then the new track slams in on the next bar."
beats 8
in_start 0.5
out_effect none 0
lane xfade 0:0:2 0.5:1:0 1:1:0
lane out_vol 0:1:0 0.449999988:1:0 0.5:0:0 1:0:0
lane out_echo 0:0:1 0.449999988:1:0 1:1:0
end

transition "Smooth Crossfade"
description "A classic, even blend over 4 bars. Safe for almost any pair of tracks."
beats 16
in_start 0
out_effect none 0
lane xfade 0:0:1 1:1:1
end

transition "Backspin"
description "Rewinds the old record like a turntablist, then drops the new track on the next downbeat."
beats 4
in_start 1
out_effect backspin 0
lane xfade 0:0:2 0.980000019:1:0 1:1:0
end

transition "Quick Cut"
description "Instantly switches tracks on the next bar. Punchy and hard to mess up."
beats 1
in_start 0
out_effect none 0
lane xfade 0:1:2 1:1:0
end

transition "Power Down"
description "The old track slows to a stop like a turntable losing power, then the new track kicks in."
beats 4
in_start 1
out_effect brake 0
lane xfade 0:0:2 0.980000019:1:0 1:1:0
end

